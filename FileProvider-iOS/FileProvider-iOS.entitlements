<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match the app's, or the extension cannot read the credential the app signed in with. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.uk.co.helmsley.HelmsleyDrive</string>
	</array>
	<!-- Where the OAuth token set lives, so the extension can spend and rotate it. Configuration
	     reads the expanded value back at runtime rather than assuming the prefix. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)uk.co.helmsley.HelmsleyDrive</string>
	</array>
	<!-- Push notifications, which is how the portal says the tree has moved: the file provider
	     extension registers with PushKit and the system signals the domain when one arrives. Xcode's
	     distribution step rewrites the value for a release build. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
