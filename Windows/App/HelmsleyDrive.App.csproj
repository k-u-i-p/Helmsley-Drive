<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe is the GUI subsystem: no console window ever opens. The engine's narration still
         goes through Console.* and lands in app.log (see Program.RedirectConsoleToLog); the CLI
         flags attach to the parent's console when there is one. -->
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>HelmsleyDrive.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The desktop SDK drops this from the implicit set; HelmsleyApi and OAuth were written
         against the plain SDK's, where it is standard. -->
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CloudFilter\HelmsleyDrive.CloudFilter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- DPAPI, which seals the token set to the signed-in Windows user (TokenStore.cs). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
