<?xml version="1.0" encoding="utf-8"?>
<!--
  The shape a tester's machine gets: one executable that needs nothing installed first.

  Self-contained because the alternative is asking every tester to find and install the .NET 8
  *Desktop* Runtime before the app will start at all — a step that costs more support than the
  170-odd megabytes it saves. Single-file because what ships should be one thing to copy, one
  thing to sign, and one thing to point an installer at.

  Not trimmed: WPF's reflection over XAML and the CsWin32 marshalling stubs are exactly what a
  trimmer cannot see, and a trimmed build that starts is not evidence that a trimmed build hydrates.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WebView2's loader among them: the sign-in sheet needs it beside the managed code, and
         without this it is left loose in the output for the installer to carry separately. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <!-- The symbols and the XML documentation of everything referenced, which otherwise ride along
         beside the executable: nothing a tester's machine has any use for, and the WebView2 SDK's
         alone is most of a megabyte. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\publish\win-arm64\</PublishDir>
  </PropertyGroup>
</Project>
