<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nothing but the sandbox: this extension holds no credential and talks to no server — it
	     relays one click to the app, which is where signing in actually happens. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
