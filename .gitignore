# Xcode per-user state. The project file and the shared scheme are tracked; window positions,
# breakpoints and the local scheme ordering are not.
xcuserdata/
*.xcuserstate
DerivedData/
build/

.DS_Store

# Local tooling state, not project configuration.
.claude/

# APNs auth keys. Apple hands the .p8 over once and never again, so a copy kept here is worth
# having — and it signs pushes for every app of the team, so it is not worth committing. The
# deployed copy is the PEM inside the portal's own gitignored config.json.
*.p8

# .NET build output, under Windows/.
bin/
obj/
.vs/

# The installers package.ps1 builds. Signed or not, they are output — a tester gets one from a
# release, never from a checkout.
dist/
